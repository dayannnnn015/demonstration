{
  "name": "edunexus",
  "version": "0.111.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "build": "vite build && tsx scripts/embed-app-page.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.web-tests.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/dev.js",
    "test": "vitest run",
    "test:race": "tsx scripts/race-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo": "tsx scripts/demo.ts",
    "seed:test-data": "tsx --env-file-if-exists=.env scripts/seed-test-data.ts",
    "seed:demo-registry": "tsx --env-file-if-exists=.env scripts/seed-demo-registry.ts",
    "seed:demo-records": "tsx --env-file-if-exists=.env scripts/seed-demo-records.ts",
    "reset:seeded-data": "tsx --env-file-if-exists=.env scripts/reset-seeded-data.ts",
    "drill:restore": "tsx --env-file-if-exists=.env scripts/restore-drill.ts",
    "drill:revocation": "tsx --env-file-if-exists=.env scripts/drill-revocation.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "db:credentials": "tsx --env-file-if-exists=.env scripts/runtime-credentials.ts",
    "api:export": "tsx scripts/export-openapi.ts",
    "dev:web": "vite",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:serve": "tsx scripts/demo-serve.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@vercel/functions": "3.9.6",
    "cors": "2.8.6",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "qrcode-generator": "2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.1.0",
    "axe-core": "4.13.0",
    "happy-dom": "20.14.5",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
