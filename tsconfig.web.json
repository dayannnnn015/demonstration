{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "vite.config.ts",
    "tests/web-api.test.ts",
    "tests/web-attendance.test.ts",
    "tests/web-calendar.test.ts",
    "tests/web-deped.test.ts",
    "tests/web-screens.test.ts",
    "tests/web-shell.test.ts",
    "tests/web-session-store.test.ts",
    "tests/web-roster-template.test.ts",
    "tests/web-help.test.ts",
    "tests/web-card-boxes.test.ts",
    "tests/web-sf2-codes.test.ts",
    "tests/web-site-page-head.test.ts",
    "tests/web-sign-in-messages.test.ts"
  ]
}
